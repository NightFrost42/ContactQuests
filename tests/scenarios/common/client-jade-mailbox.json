    {"action": "assert_server_case", "id": "server.mailbox.outsider_denied"},
    {"action": "assert_foreign_mailbox_message"},
    {"action": "interaction_mailbox", "phase": "short_name"},
    {"action": "wait_ticks", "ticks": 10},
    {"action": "assert_server_case", "id": "server.mailbox.short_name"},
