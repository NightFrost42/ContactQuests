    {"action": "wait_ticks", "ticks": 10},
    {"action": "assert_server_case", "id": "server.mailbox.long_name"},
    {"action": "use_foreign_mailbox"},
    {"action": "wait_ticks", "ticks": 20},
    {"action": "interaction_mailbox", "phase": "verify"},
